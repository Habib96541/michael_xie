  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9, g: 0.95, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 22
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 20
    m_MaxSize: 24
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.14
  m_Text: "<size=30><b><color=#00FFAA>1. HOW TO WIN:</color></b></size>\nUncover
    3 matching symbols anywhere across any horizontal row to win that row's cash
    prize!\n\n<size=30><b><color=#00FFAA>2. MULTI-ROW PAYOUTS:</color></b></size>\nAll
    5 rows evaluate independently. Win multiple rows simultaneously!\n\n<size=30><b><color=#00FFAA>3.
    NEAR-MISS PULSE:</color></b></size>\nMatch the first 2 cells to ignite an anticipation
    glow on the 3rd cell!\n\n<size=30><b><color=#00FFAA>4. QUICK REVEAL:</color></b></size>\nTap
    [REVEAL ALL] anytime to scratch all 5 rows instantly.\n\n<size=30><b><color=#FFD700>\u25C6
    SYMBOL PAYTABLE:</color></b></size>\n  \u2022 Bronze Gear: 1x (35%)       \u2022
    Plasma Gem: 15x (1.5%)\n  \u2022 Silver Ingot: 2x (22%)      \u2022 Cyber Crown:
    50x (1.0%)\n  \u2022 Gold Core: 5x (12%)         \u2022 Lucky 777: 250x JACKPOT
    (0.1%)"
