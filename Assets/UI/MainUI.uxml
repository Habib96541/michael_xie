<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GlobalStyles.uss" />
    
    <!-- 🟢 Live Background -->
    <ui:VisualElement name="live-bg-layer" class="live-bg-layer" picking-mode="Ignore" />

    <!-- ================= 1. LOADING SCREEN ================= -->
    <ui:VisualElement name="loading-screen" class="screen-container">
        <ui:Label text="BALL SORT" class="logo-title-huge" />
        <ui:Label text="DELUXE PUZZLE EDITION" class="logo-sub-large" />
        
        <!-- Filled Loading Bar -->
        <ui:VisualElement class="loading-bar-bg">
            <ui:VisualElement name="loading-bar-fill" class="loading-bar-fill" style="width: 30%;" />
        </ui:VisualElement>
        <ui:Label text="Loading... 30%" name="lbl-loading-text" class="loading-text" />
    </ui:VisualElement>

    <!-- ================= 2. HOME SCREEN ================= -->
    <ui:VisualElement name="home-screen" class="screen-container" style="display: none;">
        <ui:Label text="BALL SORT" class="logo-title-huge" />
        <ui:Label text="DELUXE PUZZLE EDITION" class="logo-sub-large" style="margin-bottom: 50px;" />
        
        <ui:Button name="btn-play-game" text="PLAY GAME" class="btn-main" />
        <ui:Button name="btn-open-settings" text="SETTINGS" class="btn-main" />
        <ui:Button name="btn-quit-game" text="QUIT" class="btn-secondary" />
    </ui:VisualElement>

    <!-- ================= 3. SETTINGS MODAL ================= -->
    <ui:VisualElement name="settings-modal" class="modal-overlay" style="display: none; z-index: 3000;">
        <ui:VisualElement class="modal-card">
            <ui:Label text="⚙" class="modal-icon" style="color: #94a3b8;" />
            <ui:Label text="SETTINGS" class="modal-title" />
            
            <ui:VisualElement class="settings-row">
                <ui:Label text="Sound Effects" class="settings-label" />
                <ui:Toggle name="toggle-sfx" value="true" />
            </ui:VisualElement>
            
            <ui:VisualElement class="settings-row">
                <ui:Label text="Music" class="settings-label" />
                <ui:Toggle name="toggle-music" value="true" />
            </ui:VisualElement>

            <!-- Ekhane 'SAVE &amp; CLOSE' thik kora hoyeche -->
            <ui:Button name="btn-close-settings" text="SAVE &amp; CLOSE" class="btn-modal-continue" style="margin-top: 20px;" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- ================= 4. GAME SCREEN ================= -->
    <ui:VisualElement name="main-container" class="main-container" style="display: none;">

        <!-- Header -->
        <ui:VisualElement class="header">
            <ui:VisualElement class="logo-area">
                <ui:Label text="BALL SORT" class="logo-title" />
                <ui:Label text="DELUXE PUZZLE EDITION" class="logo-sub" />
            </ui:VisualElement>
            
            <ui:VisualElement class="stats-area">
                <ui:VisualElement class="stat-box">
                    <ui:Label text="LEVEL" class="stat-label" />
                    <ui:Label name="lbl-level" text="1" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="divider" />
                <ui:VisualElement class="stat-box">
                    <ui:Label text="MOVES" class="stat-label" />
                    <ui:Label name="lbl-moves" text="0" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="divider" />
                <ui:VisualElement class="stat-box">
                    <ui:Label text="TIME" class="stat-label" />
                    <ui:Label name="lbl-time" text="00:00" class="stat-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="controls-area">
                <ui:Button name="btn-undo" text="Undo" class="btn-neon" />
                <ui:Button name="btn-restart" text="Restart" class="btn-neon" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Game Board -->
        <ui:VisualElement name="game-board" class="game-board" />

        <!-- Footer -->
        <ui:VisualElement class="footer">
            <ui:VisualElement class="footer-left">
                <ui:Label text="Difficulty:" class="footer-label" />
                <ui:DropdownField name="dropdown-difficulty" choices="Easy,Medium,Hard" index="1" class="dropdown" />
            </ui:VisualElement>

            <ui:VisualElement class="footer-right">
                <ui:Button name="btn-add-tube" text="+ Add Extra Tube" class="btn-neon" />
                <ui:Button name="btn-next-level" text="Next Level &gt;" class="btn-primary" style="display: none;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Victory Modal -->
        <ui:VisualElement name="victory-modal" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-card">
                <ui:Label text="★" class="modal-icon" />
                <ui:Label text="Level Cleared!" class="modal-title" />
                <ui:Label text="Fantastic! All colored balls have been sorted cleanly." class="modal-desc" />
                
                <ui:VisualElement class="modal-stats">
                    <ui:VisualElement class="modal-stat-box">
                        <ui:Label text="TOTAL MOVES" class="modal-stat-label" />
                        <ui:Label name="final-moves" text="0" class="modal-stat-value text-sky" />
                    </ui:VisualElement>
                    <ui:VisualElement class="divider" />
                    <ui:VisualElement class="modal-stat-box">
                        <ui:Label text="TIME TAKEN" class="modal-stat-label" />
                        <ui:Label name="final-time" text="00:00" class="modal-stat-value text-emerald" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Ekhane 'Next Level >' ke 'Next Level &gt;' kora hoyeche -->
                <ui:Button name="btn-modal-continue" text="Continue to Next Level &gt;" class="btn-modal-continue" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>

    <!-- Animations Layers -->
    <ui:VisualElement name="anim-layer" class="absolute-layer" picking-mode="Ignore" />
    <ui:VisualElement name="effect-layer" class="absolute-layer" picking-mode="Ignore" />
</ui:UXML>